# Copy this file to .env at the repo root and fill in your own keys.
# Do NOT commit .env with actual credentials.
#
# Which keys you need depends on which domain(s) you're running — see the
# "Compute & API budget" table in the top-level README.md.

# ── Used by: SRS domain, Simplification domain, GEC domain ──────────────────
OPENAI_API_KEY="your-openai-api-key"          # GPT-4.1 corrector (all domains)
GROQ_API_KEY="your-groq-api-key"              # Llama-3.1-8B/70B inference (rate-limited free tier)
ANTHROPIC_API_KEY="your-anthropic-api-key"    # Claude Haiku judge (Simplification + GEC)
MISTRAL_API_KEY="your-mistral-api-key"        # Mistral Large judge (Simplification + GEC)

# ── Used by: GEC domain only ─────────────────────────────────────────────────
DEEPSEEK_API_KEY="your-deepseek-api-key"      # DeepSeek V4 Flash — GEC probe generator (api.deepseek.com/v1)
HF_TOKEN="your-huggingface-token"             # required for gated models (Llama, Gemma) on HuggingFace Hub

# ── Optional ──────────────────────────────────────────────────────────────────
# OLLAMA_BASE_URL=http://localhost:11434       # if serving local models via Ollama instead of vLLM/transformers
